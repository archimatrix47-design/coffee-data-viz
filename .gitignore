node_modules/

# The 168MB filtered CSV and the FAOSTAT lookup tables it was built from. Both are
# regenerated by `npm run refresh`, so the inputs never need to be carried here. The
# manifest is the exception: it holds the Last-Modified and ETag that decide whether a
# refresh has anything to do, and losing it means re-downloading 420MB to learn nothing
# changed.
data/raw/*
!data/raw/source-manifest.json

# data/processed IS tracked, deliberately. flows.json is 12MB, which git handles without
# complaint, and it is the only thing the server needs to boot. The alternative is running
# the pipeline during deployment, which means a 420MB download on every build.

# Rendered posters. Output, not source, and megabytes each.
exports/
/*.png

# Someone else's drawing, kept locally to check the dial against. Not ours to publish.
web/vendor/reference-dial.svg

.DS_Store
*.log
.env
.env.*
!.env.example
