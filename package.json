{
  "name": "coffee-trade-viz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive visualisation of global coffee trade flows from FAOSTAT bilateral trade data",
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node --watch server/index.mjs",
    "refresh": "node pipeline/refresh.mjs",
    "aggregate": "node pipeline/aggregate.mjs",
    "start:prod": "NODE_ENV=production node server/index.mjs"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "express": "^5.1.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=20"
  }
}
